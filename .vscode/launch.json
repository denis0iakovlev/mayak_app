  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Chrome",
      "url": "http://172.20.10.3:81/",
      "request": "attach",
      "type": "chrome",
      "webRoot": "${workspaceFolder}/frontend"
    },
    {
      "name": "FastAPI",
      "type": "debugpy",
      "request": "launch",
      "console": "integratedTerminal",
      "module": "uvicorn",
      "args": ["server:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "jinja": true
    }
  ]
}
